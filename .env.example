# =================================================================
# ACCTKD · Variables de entorno
# Copia este archivo a .env.local y completa los valores
# =================================================================

# Supabase — proyecto en la nube (Vercel / producción)
# Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=https://XXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Desarrollo local (Docker + `supabase start`) ---
# Sustituye por la salida de `supabase status` (API URL y anon key).
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (clave anon local, no la de producción)

# Service role (solo servidor · API inscripción / cron). Nunca expongas en el cliente.
# IMPORTANTE: NO copies aquí la anon key. Debe ser la clave "service_role" de
# Supabase → Project Settings → API → Project API keys → service_role (secret).
# Si anon y service_role son iguales, los buckets/DDL/backups fallarán con "denied/RLS".
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cron backup campeonatos (Vercel Cron → /api/cron/backup-campeonato)
CRON_SECRET=genera-un-secreto-largo-aqui

# Sesión admin/portal/árbitro (firmar JWT HMAC). Obligatorio en producción.
SESSION_SECRET=genera-otro-secreto-largo-aqui

# Token dispositivos PSS Unity en pista (header X-PSS-Token)
PSS_API_SECRET=genera-token-pss-produccion

# Clave ops interna (config llaves sin pesaje, scripts)
# Clave dedicada de operaciones (seed producción, config llaves sin pesaje).
# NO reusar CRON_SECRET ni SESSION_SECRET.
ACCTKD_OPS_KEY=genera-clave-ops-dedicada

# Branding
NEXT_PUBLIC_APP_NAME=ACCTKD · Administración
# URL pública de producción — toda la plataforma (landing, admin, portal, TV, APIs)
NEXT_PUBLIC_APP_URL=https://festcup2026.com
NEXT_PUBLIC_ACADEMIA_NOMBRE=Christopher Cabrera Tae Kwon Do
